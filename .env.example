# ── Supabase ──────────────────────────────────────────────
# URL del projecte (Settings → API). En local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (Settings → API → service_role). NOMÉS al servidor.
# La plataforma no té login: el navegador mai rep aquesta clau.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage per a les captures (es crea amb la migració)
SUPABASE_STORAGE_BUCKET=media

# ── App ───────────────────────────────────────────────────
APP_TIMEZONE=Europe/Madrid

# URL pública de l'app (opcional; per defecte es dedueix de la petició). Apareix a /docs/api.
# NEXT_PUBLIC_APP_URL=https://el-teu-tradelab.vercel.app
